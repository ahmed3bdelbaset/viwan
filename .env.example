# ==============================================================================
# VIWAN Architecture & Design Studio — Environment Variables Template
# ==============================================================================

# Google Analytics 4 (GA4) Measurement ID
# Example: NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# GoDaddy / Microsoft 365 / Corporate SMTP Configuration
# For Microsoft 365 (via GoDaddy): smtp.office365.com (Port 587)
# For GoDaddy Webmail / cPanel: smtpout.secureserver.net (Port 465 or 587)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@viwan.net
SMTP_PASS=
SMTP_FROM="VIWAN Architecture Studio <info@viwan.net>"
